# =============================================================================
# Environment Configuration Example
# =============================================================================
# This file serves as documentation for all available environment variables.
# Copy this file to .env and update values as needed.
#
# Configuration Priority (highest to lowest):
# 1. OS Environment Variables (with APP_ prefix)
# 2. .env file variables (with APP_ prefix)
# 3. config/settings/settings.toml (default values)
#
# =============================================================================
# NAMING CONVENTION (IMPORTANT!)
# =============================================================================
# All environment variables use the APP_ prefix followed by:
# - Single underscore (_) for top-level settings: APP_SETTING_NAME
# - Double underscore (__) for nested settings: APP_SECTION__SETTING_NAME
#
# Examples:
#   Top-level:    APP_DEBUG          → settings.DEBUG
#   Nested:       APP_DATABASE__HOST → settings.database.HOST
#   Nested:       APP_KEYCLOAK__REALM → settings.keycloak.REALM
#
# This follows Dynaconf's convention where double underscore (__) represents
# nested configuration sections in settings.toml.
# =============================================================================

# Environment Switcher
# Set to: development, production, or testing
# This determines which section in settings.toml is used
ENV=production

# =============================================================================
# Application Settings (Top-level)
# =============================================================================
# Maps to settings.toml [default] section
# These use single underscore (_) because they are top-level settings
APP_SERVICE_NAME=microservice-fastapi-template
APP_SECRET_KEY=changeme-in-production-minimum-32-characters-long
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENABLE_METRICS=true
APP_DEFAULT_TIMEZONE=UTC
APP_ALLOWED_HOSTS=["*"]
APP_CORS_ORIGINS=["*"]

# =============================================================================
# CORS Configuration (Nested)
# =============================================================================
# Maps to settings.toml [cors] section
# These use double underscore (__) because they are nested under "cors"
APP_CORS__ALLOW_CREDENTIALS=true
APP_CORS__ALLOWED_METHODS=["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS", "HEAD"]
APP_CORS__ALLOWED_HEADERS=["Accept", "Accept-Language", "Content-Language", "Content-Type", "Authorization", "X-Requested-With", "X-Request-ID", "Origin", "Cache-Control", "Pragma"]
APP_CORS__EXPOSED_HEADERS=["X-Request-ID", "X-Process-Time", "Content-Type", "Content-Length", "X-Estimated-Bytes"]
APP_CORS__MAX_AGE=3600

# =============================================================================
# Database Configuration (Nested)
# =============================================================================
# Maps to settings.toml [database] section
# These use double underscore (__) because they are nested under "database"
APP_DATABASE__ENABLED=true
APP_DATABASE__DRIVER=postgresql+asyncpg
APP_DATABASE__HOST=postgres
APP_DATABASE__PORT=5432
APP_DATABASE__NAME=app_db
APP_DATABASE__USER=postgres
APP_DATABASE__PASSWORD=postgres
APP_DATABASE__POOL_SIZE=5
APP_DATABASE__MAX_OVERFLOW=10
APP_DATABASE__POOL_PRE_PING=true
APP_DATABASE__POOL_RECYCLE=3600
APP_DATABASE__POOL_TIMEOUT=30
APP_DATABASE__ECHO=false

# =============================================================================
# Uvicorn Configuration (Nested)
# =============================================================================
# Maps to settings.toml [uvicorn] section
# These use double underscore (__) because they are nested under "uvicorn"
APP_UVICORN__WORKERS=1
APP_UVICORN__WORKERS_MAX=4
APP_UVICORN__WORKER_CLASS=uvicorn.workers.UvicornWorker
APP_UVICORN__TIMEOUT_KEEP_ALIVE=5
APP_UVICORN__LIMIT_CONCURRENCY=1000
APP_UVICORN__LIMIT_MAX_REQUESTS=50000
APP_UVICORN__LIMIT_MAX_REQUESTS_JITTER=5000
APP_UVICORN__BACKLOG=2048

# =============================================================================
# Redis Configuration (Nested)
# =============================================================================
# Maps to settings.toml [redis] section
# These use double underscore (__) because they are nested under "redis"
APP_REDIS__ENABLED=false
APP_REDIS__HOST=redis
APP_REDIS__PORT=6379
APP_REDIS__DB=0
APP_REDIS__PASSWORD=
APP_REDIS__SSL=false
APP_REDIS__SOCKET_TIMEOUT=5
APP_REDIS__SOCKET_CONNECT_TIMEOUT=5
APP_REDIS__RETRY_ON_TIMEOUT=true
APP_REDIS__MAX_CONNECTIONS=50

# =============================================================================
# Auth OTP (two-step login) — requires Redis enabled
# =============================================================================
# Maps to settings.toml [auth] section
APP_AUTH__ENABLED=true
# Auth provider: sso (Keycloak) or jwt (local accounts; run migrations first)
APP_AUTH__MODE=sso
# Optional dedicated JWT signing key (>= 32 chars); defaults to APP_SECRET_KEY
# APP_AUTH__JWT_SECRET_KEY=changeme
APP_AUTH__OTP_ENABLED=false
APP_AUTH__OTP_SESSION_TTL_SECONDS=300
APP_AUTH__OTP_MAX_ATTEMPTS=5
APP_AUTH__OTP_VALIDITY_SECONDS=120
APP_AUTH__OTP_RATE_LIMIT_LOGIN_PER_MIN=10
APP_AUTH__OTP_RATE_LIMIT_VERIFY_PER_MIN=20
APP_AUTH__OTP_RESEND_MAX_PER_SESSION=3
APP_AUTH__OTP_RESEND_WINDOW_SECONDS=900
APP_AUTH__OTP_SMS_MOCK_ENABLED=false
APP_AUTH__OTP_SMS_URL=
APP_AUTH__OTP_PLATFORM_NAME=iTicket
# OTP bypass: static code that bypasses verification (for development/testing only)
# WARNING: Should be disabled in production for security
APP_AUTH__OTP_BYPASS_ENABLED=false
APP_AUTH__OTP_BYPASS_CODE=

# =============================================================================
# Keycloak Configuration (Nested)
# =============================================================================
# Maps to settings.toml [keycloak] section
# These use double underscore (__) because they are nested under "keycloak"
APP_KEYCLOAK__ENABLED=true
APP_KEYCLOAK__SERVER_URL=http://localhost:8080
APP_KEYCLOAK__REALM=master
APP_KEYCLOAK__CLIENT_ID=your-client-id
APP_KEYCLOAK__CLIENT_SECRET=your-client-secret
APP_KEYCLOAK__ADMIN_USERNAME=admin
APP_KEYCLOAK__ADMIN_PASSWORD=admin
APP_KEYCLOAK__AUDIENCE=workflow-identity-client
APP_KEYCLOAK__AUDIENCE_VALIDATION_ENABLED=true

# =============================================================================
# MinIO/S3 Configuration (Nested)
# =============================================================================
# Maps to settings.toml [s3] section
# These use double underscore (__) because they are nested under "s3"
APP_S3__ENABLED=false
APP_S3__ENDPOINT_URL=http://localhost:9000
APP_S3__ACCESS_KEY_ID=minioadmin
APP_S3__SECRET_ACCESS_KEY=minioadmin
APP_S3__REGION=us-east-1
APP_S3__USE_SSL=false
APP_S3__BUCKET_NAME=default-bucket
APP_S3__MAX_UPLOAD_SIZE_MB=100
APP_S3__PRESIGNED_URL_EXPIRY=3600

# =============================================================================
# Metrics Authentication Configuration (Nested)
# =============================================================================
# Maps to settings.toml [metrics] section
# These use double underscore (__) because they are nested under "metrics"
# IMPORTANT: Enable authentication in production and set secure credentials
APP_METRICS__AUTH_ENABLED=true
APP_METRICS__AUTH_METHOD=basic
APP_METRICS__AUTH_USERNAME=prometheus
# WARNING: Set a strong password via environment variable or secrets management
# Never commit actual passwords to version control
APP_METRICS__AUTH_PASSWORD=changeme-in-production-minimum-32-characters-long
APP_METRICS__AUTH_BEARER_TOKEN=
