# =============================================================================
# Environment Configuration Example
# =============================================================================
# This file serves as documentation for all available environment variables.
# Copy this file to .env and update values as needed.
#
# Configuration Priority (highest to lowest):
# 1. OS Environment Variables (with APP_ prefix)
# 2. .env file variables (with APP_ prefix)
# 3. config/settings/settings.toml (default values)
#
# =============================================================================
# NAMING CONVENTION (IMPORTANT!)
# =============================================================================
# All environment variables use the APP_ prefix followed by:
# - Single underscore (_) for top-level settings: APP_SETTING_NAME
# - Double underscore (__) for nested settings: APP_SECTION__SETTING_NAME
#
# Examples:
#   Top-level:    APP_DEBUG          → settings.DEBUG
#   Nested:       APP_DATABASE__HOST → settings.database.HOST
#   Nested:       APP_KEYCLOAK__REALM → settings.keycloak.REALM
#
# This follows Dynaconf's convention where double underscore (__) represents
# nested configuration sections in settings.toml.
# =============================================================================

# Environment Switcher
# Set to: development, production, or testing
# This determines which section in settings.toml is used
ENV=development

# =============================================================================
# Application Settings (Top-level)
# =============================================================================
# Maps to settings.toml [default] section
# These use single underscore (_) because they are top-level settings
APP_SERVICE_NAME=dental-labs-backend
APP_SECRET_KEY=cijiCJdXgoUU9bqte-Sapej4oKKyEbUMpRy9KNaQ8pOOk65EdqJiqQI6h7jQK6sSOJLUe6T7IfmahBydtX2ZYA
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_LOGGING__FORMAT=pretty
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENABLE_METRICS=true
APP_DEFAULT_TIMEZONE=UTC
APP_ALLOWED_HOSTS=["*"]

# =============================================================================
# CORS Configuration (Nested)
# =============================================================================
# Maps to settings.toml [cors] section. ORIGINS: comma-separated, no @json
# Dev: * allows all. Prod: APP_CORS__ORIGINS=http://localhost:8001,https://your-domain.com
APP_CORS__ORIGINS=*
APP_CORS__ALLOW_CREDENTIALS=true
APP_CORS__ALLOWED_METHODS=["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS", "HEAD"]
APP_CORS__ALLOWED_HEADERS=["Accept", "Accept-Language", "Content-Language", "Content-Type", "Authorization", "X-Requested-With", "X-Request-ID", "Origin", "Cache-Control", "Pragma"]
APP_CORS__EXPOSED_HEADERS=["X-Request-ID", "X-Process-Time", "Content-Type", "Content-Length", "X-Estimated-Bytes"]
APP_CORS__MAX_AGE=3600

# =============================================================================
# Database Configuration (Nested)
# =============================================================================
# Maps to settings.toml [database] section
# These use double underscore (__) because they are nested under "database"
APP_DATABASE__ENABLED=true
APP_DATABASE__DRIVER=postgresql+asyncpg
APP_DATABASE__HOST=127.0.0.1
APP_DATABASE__PORT=5432
APP_DATABASE__NAME=dental
APP_DATABASE__USER=postgres
APP_DATABASE__PASSWORD=1234
APP_DATABASE__POOL_SIZE=5
APP_DATABASE__MAX_OVERFLOW=10
APP_DATABASE__POOL_PRE_PING=true
APP_DATABASE__POOL_RECYCLE=3600
APP_DATABASE__POOL_TIMEOUT=30
APP_DATABASE__ECHO=false

# =============================================================================
# Uvicorn Configuration (Nested)
# =============================================================================
# Maps to settings.toml [uvicorn] section
# These use double underscore (__) because they are nested under "uvicorn"
APP_UVICORN__WORKERS=1
APP_UVICORN__WORKERS_MAX=4
APP_UVICORN__WORKER_CLASS=uvicorn.workers.UvicornWorker
APP_UVICORN__TIMEOUT_KEEP_ALIVE=5
APP_UVICORN__LIMIT_CONCURRENCY=1000
APP_UVICORN__LIMIT_MAX_REQUESTS=10000
APP_UVICORN__LIMIT_MAX_REQUESTS_JITTER=1000
APP_UVICORN__BACKLOG=2048
